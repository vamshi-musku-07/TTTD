# =============================================================================
# Local development — copy to .env and fill in values
#   cp .env.example .env
# =============================================================================

NODE_ENV=development
PORT=5000
HOST=127.0.0.1

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/tttd

# JWT — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL(s) for CORS — comma-separated for multiple origins
CLIENT_URL=http://localhost:5173

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mediaflow

# Auth cookies (optional in dev)
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# Serve built frontend from backend (single-server deploy)
SERVE_FRONTEND=false
# FRONTEND_DIST_PATH=../frontend/dist

# SMTP (optional in dev — emails log to console if unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TTTD <noreply@yourdomain.com>"
