# =============================================================================
# Production — copy to .env on your server / set in hosting dashboard
#   cp .env.production.example .env
# =============================================================================

NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# MongoDB Atlas or managed MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/tttd?retryWrites=true&w=majority

# JWT — REQUIRED: strong random secrets (openssl rand -base64 64)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Deployment A — same domain (recommended)
# Build frontend with VITE_API_URL=/api, enable SERVE_FRONTEND
# -----------------------------------------------------------------------------
CLIENT_URL=https://yourdomain.com
SERVE_FRONTEND=true
FRONTEND_DIST_PATH=../frontend/dist

# Auth cookies (same domain)
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
# COOKIE_DOMAIN=.yourdomain.com

# -----------------------------------------------------------------------------
# Deployment B — split frontend + API hosts
# Frontend: VITE_API_URL=https://api.yourdomain.com/api
# -----------------------------------------------------------------------------
# CLIENT_URL=https://app.yourdomain.com
# SERVE_FRONTEND=false
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=

# Google OAuth — add authorized origins + redirect URIs for production URLs
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mediaflow

# SMTP (recommended in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TTTD <noreply@yourdomain.com>"
