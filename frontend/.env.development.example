# =============================================================================
# Local development — copy to .env.development
#   cp .env.development.example .env.development
# =============================================================================

# API base URL (Vite dev server proxies /api → backend)
VITE_API_URL=/api

# Optional: override backend proxy target (default http://localhost:5000)
# VITE_DEV_API_PROXY=http://localhost:5000

# Google OAuth — same client ID as backend GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
