# =============================================================================
# Production build — copy to .env.production before npm run build
#   cp .env.production.example .env.production
# =============================================================================

# Use /api when deploying on Vercel (vercel.json proxies /api → Render)
VITE_API_URL=/api

# Google OAuth — production client ID (authorized origins must include your Vercel URL)
VITE_GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
