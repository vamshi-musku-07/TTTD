# =============================================================================
# Production build — copy to .env.production before npm run build
#   cp .env.production.example .env.production
# =============================================================================

# -----------------------------------------------------------------------------
# Option A — same domain (backend serves app + API, or nginx proxies /api)
# -----------------------------------------------------------------------------
VITE_API_URL=/api

# -----------------------------------------------------------------------------
# Option B — API on a separate host
# -----------------------------------------------------------------------------
# VITE_API_URL=https://api.yourdomain.com/api

# Google OAuth — production client ID (authorized origins must include your app URL)
VITE_GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
